{
  "name": "ghost-from-the-past",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ghost-memory",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],

  "vectorize": [
    {
      "binding": "VECTORS",
      "index_name": "ghost-memory"
    }
  ],

  "ai": {
    "binding": "AI"
  },

  // Optional basic rate limit (Workers Rate Limiting binding), keyed per route + client IP in src/index.ts.
  "ratelimits": [
    { "name": "LIMITER", "namespace_id": "1001", "simple": { "limit": 300, "period": 60 } }
  ],

  "vars": {
    "EMBED_MODEL": "@cf/baai/bge-small-en-v1.5",
    "MAX_CHUNKS_PER_PAGE": "8"
  },

  "observability": {
    "enabled": true
  },

  "env": {
    "local": {
      "name": "ghost-from-the-past-local",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "ghost-memory",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations"
        }
      ],
      "vars": {
        "EMBED_MODE": "mock",
        "VECTOR_MODE": "d1",
        "EMBED_MODEL": "@cf/baai/bge-small-en-v1.5",
        "MAX_CHUNKS_PER_PAGE": "8"
      }
    }
  }
}
