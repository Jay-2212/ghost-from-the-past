{
  "version": "v1",
  "hooks": [
    {
      "name": "secret-guard",
      "description": "Scan git diff --cached and file paths for secrets before committing or writing files",
      "trigger": "PreToolUse",
      "matcher": {
        "toolName": ["shell", "write"],
        "files": ["worker/src/.*\\.ts$", ".kiro/specs/.*\\.md$"]
      },
      "action": {
        "type": "command",
        "command": "node .kiro/hooks/secret-guard.mjs"
      }
    }
  ]
}
